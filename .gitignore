cat > .gitignore <<'EOF'
# colcon build artifacts
build/
install/
log/

# Python / ROS
__pycache__/
*.py[cod]
*.egg-info/

# TF tree dumps from view_frames
frames_*.pdf
frames_*.gv

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# SLAM pose graphs (large, regenerated by mapping), anywhere in the repo
*.posegraph
*.data

# Old backup maps
src/amr_navigation/maps/warehouse_try1*
EOF